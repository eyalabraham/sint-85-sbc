                    ;
                    ; Display word value stored in $38f6 left 7-segment
                    ; word display.
                    ;
                    ; Input:
                    ;   work stored in memory address $38f6 - $0000 to $ffff
                    ; Output:
                    ;   Display to left side word digits 7-segment
                    ;   A, D, E, H, L - destroyed
                    ;
0248 2a f6 38  |    DSPMEMWRD:    LHLD  $38f6
024b eb        |                  XCHG
                    ;
                    ; Display value of DE on left 7-segment
                    ; word display.
                    ;
                    ; Input:
                    ;   DE - value $0000 to $ffff
                    ; Output:
                    ;   Display to left side word digits 7-segment
                    ;   A, D, E - destroyed
                    ;
024c cd 25 03  |    DSPRDEWRD:    CALL  $0325       ; Unpack DE into nibbles
024f af        |                  XRA   A           ; Signal 4-digit hex
0250 cd 68 02  |                  CALL  $0268       ; Write to 8279 and displays
0253 c9        |                  RET
