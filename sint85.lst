                    ;
                    ; 8279 font table
                    ;   Maps each nibble value $0–$f to its 7-segment pattern. 
                    ;   The command $94 selects the 2-digit group (display RAM addresses 4–5 on the 8279,
                    ;   which drive the separate two-digit display), while $90 selects the 4-digit group
                    ;   (addresses 0–3).
                    ;
                    ;        ─a─
                    ;       f   b
                    ;        ─g─
                    ;       e   c
                    ;        ─d─  (dp)
                    ;
                    ;   Bit:   7   6   5   4   3   2   1   0
                    ;   Seg:   d   c   b   a  dp   g   f   e 
                    ;
036b f3        |                  DB    $f3         ; 0
036c 60        |                  DB    $60         ; 1
036d b5        |                  DB    $b5         ; 2
036e f4        |                  DB    $f4         ; 3
036f 66        |                  DB    $66         ; 4
0370 d6        |                  DB    $d6         ; 5
0371 d7        |                  DB    $d7         ; 6
0372 70        |                  DB    $70         ; 7
0373 f7        |                  DB    $f7         ; 8
0374 76        |                  DB    $76         ; 9
0375 77        |                  DB    $77         ; A
0376 c7        |                  DB    $c7         ; B
0377 93        |                  DB    $93         ; C
0378 e5        |                  DB    $e5         ; D
0379 97        |                  DB    $97         ; E
037a 17        |                  DB    $17         ; F
